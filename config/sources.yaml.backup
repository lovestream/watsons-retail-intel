tavily:
  rotation: round_robin
  keys_env_vars:
  - tavily_key
  - tavily_key1
  - tavily_key2
  - tavily_key3
  - tavily_key4
  - tavily_key5
  monthly_limit_per_key: 1000
  timeout_seconds: 30
  max_results_per_query: 5
  search_depth: advanced
tavily_sources: []
web_monitor_sources:
- id: web_36kr_newsflashes
  name: 36kr快讯(直连)
  category: 综合快讯
  role: primary_timeline
  tier: tier1_core
  source_type: web_monitor
  source_tier: 1
  daily_priority: 100
  method: web_monitor
  monitor:
    enabled: true
    list_urls:
    - https://36kr.com/newsflashes
    - https://36kr.com/information/technology
    link_include_patterns:
    - /p/
    link_exclude_patterns:
    - /tag/
    - /user/
    - /login
    - /motify/
    - /column/
- id: web_latepost
  name: 晚点LatePost(直连)
  category: 商业深度
  role: primary_timeline
  tier: tier2_analysis
  source_type: web_monitor
  source_tier: 2
  daily_priority: 90
  method: web_monitor
  monitor:
    enabled: true
    list_urls:
    - https://www.latepost.com
    - https://www.latepost.com/news/index
    link_include_patterns:
    - /article/
    link_exclude_patterns:
    - /site/about
    - /websites/
    - /site/index
- id: web_jiemian_business
  name: 界面新闻-商业(直连)
  category: 综合快讯
