rsshub_base: http://192.168.2.100:1200
defaults:
  timeout_seconds: 20
  max_items_per_route: 20
  request_interval_seconds: 0.5
  allow_unknown_time: true
  allow_old: false
  filterout_days: 90
collection_limits:
  max_total_items_before_dedup: 1200
  max_items_after_dedup: 600
  max_items_for_fulltext: 200
  max_items_for_filter_skill: 600
tavily:
  rotation: round_robin
  keys_env_vars:
  - tavily_key
  - tavily_key1
  - tavily_key2
  monthly_limit_per_key: 1000
  timeout_seconds: 30
  max_results_per_query: 10
  search_depth: advanced
xcrawl:
  keys_env_vars:
  - xcrawl_key
  - xcrawl_key1
  - xcrawl_key2
  monthly_limit_per_key: 1000
other_sources:
